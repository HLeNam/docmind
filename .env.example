# .env
NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=my_app_db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# app runtime PHẢI dùng role docmind_app — đây là connection PrismaService thật sự dùng
# giá trị "..." dưới đây là password THẬT bạn đặt qua script rotate ở mục 2.3, không phải 'change_me_in_env'
APP_DATABASE_URL="postgresql://docmind_app:123456789@localhost:5433/docmind?schema=public"

# chỉ dùng cho truy vấn admin/xuyên-tenant hợp lệ (Super Admin dashboard, job hệ thống...)
SYSTEM_DATABASE_URL="postgresql://docmind_system:123456789@localhost:5433/docmind?schema=public"