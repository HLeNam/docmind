# .env
NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=my_app_db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

GOOGLE_CLIENT_ID=

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# app runtime PHẢI dùng role docmind_app — đây là connection PrismaService thật sự dùng
# giá trị "..." dưới đây là password THẬT bạn đặt qua script rotate ở mục 2.3, không phải 'change_me_in_env'
APP_DATABASE_URL="postgresql://docmind_app:123456789@localhost:5433/docmind?schema=public"

# chỉ dùng cho truy vấn admin/xuyên-tenant hợp lệ (Super Admin dashboard, job hệ thống...)
SYSTEM_DATABASE_URL="postgresql://docmind_system:123456789@localhost:5433/docmind?schema=public"

MAIL_PROVIDER=
MAIL_FROM=

FRONTEND_URL=

RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

BREVO_API_KEY=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=docmind-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

REDIS_URL=redis://localhost:6379

EMBEDDING_PROVIDER=jina   # 'openai' (mặc định) | 'gemini' | 'jina' | 'ollama'

# Khi dùng Jina:
JINA_API_KEY=                        # lấy free tại https://jina.ai (không cần thẻ thanh toán)
JINA_EMBEDDING_MODEL=jina-embeddings-v4   # LƯU Ý: v4, không phải v5 — v5 chỉ tối đa 1024 chiều
JINA_EMBEDDING_DIMENSIONS=1536       # PHẢI là 1536 để khớp cột DB hiện tại

# Khi dùng Gemini:
GEMINI_API_KEY=                      # lấy free tại https://aistudio.google.com/apikey
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# Khi dùng Ollama (chạy hoàn toàn local, không gọi internet):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

LLM_PROVIDER=gemini          # hiện chỉ hỗ trợ 'gemini', thêm provider khác sau theo đúng pattern Embedding

GEMINI_CHAT_MODEL=gemini-3.8-flash   # KIỂM TRA LẠI tên model free-tier hiện có trước khi dùng thật
# GEMINI_API_KEY: dùng CHUNG với EmbeddingModule, không cần thêm biến mới

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=<PUBLIC_URL>/slack/oauth/callback
SLACK_TOKEN_ENCRYPTION_KEY=